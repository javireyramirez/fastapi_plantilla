# ==========================================
# 1. Server / Application
# ==========================================
FASTAPI_PLANTILLA_HOST=127.0.0.1
FASTAPI_PLANTILLA_PORT=8000
FASTAPI_PLANTILLA_ENVIRONMENT=dev
FASTAPI_PLANTILLA_RELOAD=True
FASTAPI_PLANTILLA_LOG_LEVEL=INFO

# ==========================================
# 2. Database (PostgreSQL Async)
# ==========================================
FASTAPI_PLANTILLA_DB_HOST=localhost
FASTAPI_PLANTILLA_DB_PORT=5432
FASTAPI_PLANTILLA_DB_USER=fastapi_plantilla
FASTAPI_PLANTILLA_DB_PASS=changethis_secure_db_password
FASTAPI_PLANTILLA_DB_BASE=fastapi_plantilla
FASTAPI_PLANTILLA_DB_ECHO=False
# FASTAPI_PLANTILLA_DB_POOL_SIZE=10
# FASTAPI_PLANTILLA_DB_MAX_OVERFLOW=20

# ==========================================
# 3. Authentication & Security
# ==========================================
FASTAPI_PLANTILLA_AUTH_SECRET=changethis_to_a_secure_64_character_hex_string
FASTAPI_PLANTILLA_SESSION_COOKIE_NAME=fastapi_session
FASTAPI_PLANTILLA_SESSION_EXPIRE_DAYS=7
FASTAPI_PLANTILLA_COOKIE_SECURE=False

# Initial SuperAdmin Bootstrap (Optional, automatically seeded on startup)
FASTAPI_PLANTILLA_INITIAL_SUPERADMIN_EMAIL=admin@example.com
FASTAPI_PLANTILLA_INITIAL_SUPERADMIN_PASSWORD=change_this_superadmin_password_123!
FASTAPI_PLANTILLA_INITIAL_SUPERADMIN_NAME=Super Admin

# Google OAuth (Optional)
FASTAPI_PLANTILLA_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
FASTAPI_PLANTILLA_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# 4. Email Configuration
# ==========================================
# Common
FASTAPI_PLANTILLA_EMAILS_FROM_EMAIL=noreply@example.com
FASTAPI_PLANTILLA_EMAILS_FROM_NAME=FastAPI Plantilla
FASTAPI_PLANTILLA_FRONTEND_URL=http://localhost:3000

# --- OPCIÓN 1: Desarrollo Local con Mailpit (Activa por defecto) ---
FASTAPI_PLANTILLA_EMAIL_BACKEND=smtp
FASTAPI_PLANTILLA_SMTP_HOST=localhost
FASTAPI_PLANTILLA_SMTP_PORT=1025
FASTAPI_PLANTILLA_SMTP_TLS=False

# --- OPCIÓN 2: Resend (Producción Cloud / Startups) ---
# FASTAPI_PLANTILLA_EMAIL_BACKEND=resend
# FASTAPI_PLANTILLA_RESEND_API_KEY=re_your_resend_api_key

# --- OPCIÓN 3: SMTP Corporativo Producción (Office 365 / Google / SendGrid) ---
# FASTAPI_PLANTILLA_EMAIL_BACKEND=smtp
# FASTAPI_PLANTILLA_SMTP_HOST=smtp.office365.com
# FASTAPI_PLANTILLA_SMTP_PORT=587
# FASTAPI_PLANTILLA_SMTP_USER=soporte@tuempresa.com
# FASTAPI_PLANTILLA_SMTP_PASSWORD=your_smtp_password
# FASTAPI_PLANTILLA_SMTP_TLS=True

# ==========================================
# 5. Storage Configuration (Multi-Cloud / Local)
# ==========================================
# Opciones para STORAGE_BACKEND: local | s3 | azure | gcs
FASTAPI_PLANTILLA_STORAGE_BACKEND=local
FASTAPI_PLANTILLA_STORAGE_BUCKET=fastapi-plantilla-bucket
FASTAPI_PLANTILLA_STORAGE_LOCAL_PATH=./storage_data
FASTAPI_PLANTILLA_STORAGE_LOCAL_BASE_URL=http://localhost:8000

# --- OPCIÓN S3 / MinIO ---
# FASTAPI_PLANTILLA_STORAGE_BACKEND=s3
# FASTAPI_PLANTILLA_STORAGE_BUCKET=mi-bucket-s3
# FASTAPI_PLANTILLA_STORAGE_S3_ENDPOINT_URL=http://localhost:9000
# FASTAPI_PLANTILLA_STORAGE_S3_ACCESS_KEY=your_s3_access_key
# FASTAPI_PLANTILLA_STORAGE_S3_SECRET_KEY=your_s3_secret_key
# FASTAPI_PLANTILLA_STORAGE_S3_REGION=us-east-1

# --- OPCIÓN Azure Blob Storage ---
# FASTAPI_PLANTILLA_STORAGE_BACKEND=azure
# FASTAPI_PLANTILLA_STORAGE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# FASTAPI_PLANTILLA_STORAGE_AZURE_ACCOUNT_NAME=your_azure_account_name
# FASTAPI_PLANTILLA_STORAGE_AZURE_ACCOUNT_KEY=your_azure_account_key
# FASTAPI_PLANTILLA_STORAGE_AZURE_CONTAINER=fastapi-container

# --- OPCIÓN Google Cloud Storage (GCS) ---
# FASTAPI_PLANTILLA_STORAGE_BACKEND=gcs
# FASTAPI_PLANTILLA_STORAGE_GCS_PROJECT=your-gcp-project-id
# FASTAPI_PLANTILLA_STORAGE_GCS_CREDENTIALS_FILE=/path/to/gcs-credentials.json

# ==========================================
# 6. Trash Bin & Retention Purge Background Job
# ==========================================
FASTAPI_PLANTILLA_TRASH_RETENTION_DAYS=30
FASTAPI_PLANTILLA_TRASH_PURGE_INTERVAL_HOURS=24
FASTAPI_PLANTILLA_TRASH_PURGE_ENABLED=True
